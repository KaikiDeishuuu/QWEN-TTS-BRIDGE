[Unit]
Description=OpenClaw TTS Bridge Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/.openclaw/workspace/Graces_Tools/QWEN-TTS-BRIDGE
EnvironmentFile=/root/.openclaw/workspace/Graces_Tools/QWEN-TTS-BRIDGE/.env
ExecStart=/root/.openclaw/workspace/Graces_Tools/QWEN-TTS-BRIDGE/venv_bridge/bin/uvicorn tts_bridge.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
