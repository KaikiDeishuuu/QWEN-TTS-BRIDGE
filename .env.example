# Required: DashScope API key used by Qwen realtime TTS.
DASHSCOPE_API_KEY=

# Required: Internal bearer token expected by /tts endpoint.
INTERNAL_TTS_TOKEN=

# Container runtime host and exposed HTTP port.
HOST=0.0.0.0
PORT=8000

# TTS service settings.
TTS_MODEL=qwen3-tts-instruct-flash-realtime
TTS_VOICE=Maia
QWEN_WS_BASE=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
WS_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=8
MIN_PCM_BYTES=4800
FFMPEG_TIMEOUT=30
ENABLE_NATIVE_FALLBACK=false

# Optional Feishu delivery settings.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_UPLOAD_TIMEOUT=20
