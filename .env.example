# Qwen API Key from DashScope (Aliyun)
DASHSCOPE_API_KEY=sk-your-real-key-here

# TTS Configuration
TTS_MODEL=qwen3-tts-instruct-flash-realtime
TTS_VOICE=Maia
TTS_PORT=8000
TTS_HOST=127.0.0.1

# Security Token for internal communication (shared with OpenClaw)
INTERNAL_TTS_TOKEN=generate-a-strong-token-here

# Optional: Qwen WebSocket Base URL
# QWEN_WS_BASE=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# WS_TIMEOUT_SECONDS=45
